{
  "$schema": "./schemas/config.schema.json",
  "defaultHarness": "claude",
  "guestWorkspace": "auto",
  "readOnly": false,
  "workspaceFilter": {
    "enabled": false,
    "exclude": [],
    "include": []
  },
  "audit": {
    "enabled": false,
    "days": 14,
    "maxMb": 100,
    "processes": true,
    "files": true
  },
  "mappings": [],
  "sandbox": {
    "engine": "windows-sandbox",
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "maxMemoryPercent": 80,
    "cpuLimit": 80,
    "pageFileMb": 16384,
    "reserveHostMb": 8192,
    "agentMemoryHeadroomMb": "auto",
    "pressureResponse": true,
    "vGpu": false,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true,
    "headless": false,
    "keepAwake": true
  },
  "sharing": {
    "otherUsers": false
  },
  "storage": {
    "root": "%ProgramData%\\AgentSandbox\\users\\%USERNAME%",
    "persistAgentState": true,
    "dataName": "default",
    "markSandboxFiles": true,
    "contained": "off",
    "containedMaxGb": 64,
    "warnDataGb": 50
  },
  "network": {
    "blockPrivateRanges": true,
    "allowOnly": [],
    "blockHosts": [],
    "forwardPorts": [],
    "dns": [],
    "proxy": ""
  },
  "vpn": {
    "enabled": false,
    "provider": "nordvpn",
    "protocol": "udp",
    "country": "",
    "configFile": "",
    "killSwitch": true
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "git": {
      "enabled": true,
      "access": "full"
    },
    "terminal": {
      "enabled": true
    },
    "conpty": {
      "enabled": true
    }
  },
  "downloads": {
    "requireChecksum": false
  },
  "toolchains": {
    "node": {
      "version": "host",
      "extraVersions": [],
      "corepack": true,
      "volta": "auto",
      "globalPackages": []
    },
    "python": {
      "enabled": "auto",
      "version": "3",
      "python2": true,
      "pyenv": "auto",
      "tools": []
    },
    "rust": {
      "enabled": "auto",
      "toolchain": "stable",
      "host": "auto",
      "components": [],
      "targets": [],
      "crates": [],
      "targetDir": "separate",
      "linker": "lld",
      "linkSlots": "auto"
    },
    "msvc": {
      "enabled": "auto",
      "acceptLicense": false,
      "msvcVersion": "latest",
      "sdkVersion": "latest"
    },
    "cpp": {
      "enabled": "auto",
      "flexBison": true
    },
    "dotnet": {
      "enabled": "auto",
      "channels": [
        "LTS"
      ],
      "tools": [],
      "workloads": [],
      "frameworkTargets": [
        "net48",
        "net472"
      ],
      "netfx35": false
    },
    "go": {
      "enabled": "auto",
      "version": "stable",
      "tools": []
    },
    "java": {
      "enabled": "auto",
      "version": "lts",
      "maven": true,
      "gradle": true
    },
    "ruby": {
      "enabled": "auto",
      "version": "3",
      "gems": []
    },
    "php": {
      "enabled": "auto",
      "version": "8",
      "composer": true
    },
    "deno": {
      "enabled": "auto"
    },
    "pwsh": {
      "enabled": "auto"
    },
    "cli": {
      "gh": "auto",
      "zstd": false,
      "openssl": "auto"
    },
    "bun": {
      "enabled": "auto"
    },
    "uv": {
      "enabled": "auto"
    },
    "vcRuntime": {
      "enabled": false
    },
    "mesa": {
      "enabled": false,
      "vulkan": false
    },
    "vscode": {
      "enabled": "auto",
      "setup": true,
      "recommended": true,
      "extensions": []
    },
    "environment": {}
  },
  "databases": {
    "postgres": {
      "enabled": "auto",
      "version": "latest",
      "port": 5432
    },
    "mysql": {
      "enabled": "auto",
      "version": "lts",
      "port": 3306
    },
    "mongodb": {
      "enabled": "auto",
      "version": "latest",
      "port": 27017
    },
    "redis": {
      "enabled": "auto",
      "port": 6379
    },
    "dynamodb": {
      "enabled": "auto",
      "port": 8000,
      "adminPort": 8001,
      "admin": true
    },
    "sqlserver": {
      "enabled": "auto"
    }
  },
  "attach": {
    "enabled": true,
    "reuseSession": true,
    "auto": false,
    "autoHide": false,
    "confirmCtrlC": true
  },
  "web": {
    "enabled": false,
    "port": 47800,
    "openOnLaunch": false
  },
  "agentCommands": {
    "enabled": false,
    "agents": "auto"
  },
  "secrets": {
    "strip": true,
    "allow": [],
    "patterns": [],
    "warnFiles": true
  },
  "personalization": {
    "enabled": true
  },
  "apps": {
    "install": [],
    "custom": {}
  },
  "claudeProfile": {
    "enabled": true,
    "hostDir": "auto",
    "include": [
      "settings.json",
      "CLAUDE.md",
      "commands",
      "agents",
      "skills",
      "plugins"
    ],
    "globalStateFile": "auto",
    "copyCredentials": false,
    "overwrite": true,
    "sharePluginsAcrossAccounts": false,
    "syncHistory": true,
    "historyScope": "project",
    "syncClaudeMem": true,
    "syncClaudeMemBack": false
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      },
      "home": {
        "env": {
          "CLAUDE_CONFIG_DIR": "claude"
        },
        "loginFiles": [
          ".credentials.json"
        ],
        "hostDir": "~/.claude"
      },
      "resumeArguments": [
        "--continue"
      ],
      "resumeOneArguments": [
        "--resume",
        "{id}"
      ]
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "CODEX_HOME": "codex"
        },
        "loginFiles": [
          "auth.json"
        ],
        "hostDir": "~/.codex"
      },
      "localState": {
        "CODEX_SQLITE_HOME": "sqlite"
      },
      "bootReset": [
        ".sandbox-secrets",
        ".sandbox\\setup_marker.json",
        ".sandbox\\deny_read_acl_state.json"
      ],
      "resumeArguments": [
        "resume",
        "--last"
      ]
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "GEMINI_CLI_HOME": "gemini"
        },
        "loginFiles": [
          ".gemini/oauth_creds.json",
          ".gemini/google_accounts.json"
        ],
        "hostDir": "~"
      },
      "resumeArguments": [
        "--resume"
      ]
    },
    "opencode": {
      "npmPackage": "opencode-ai@latest",
      "npmBin": "opencode",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".local/share/opencode",
          ".config/opencode"
        ],
        "loginFiles": [
          "profile/.local/share/opencode/auth.json"
        ]
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "qwen": {
      "npmPackage": "@qwen-code/qwen-code@latest",
      "npmBin": "qwen",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".qwen"
        ],
        "loginFiles": [
          "profile/.qwen/oauth_creds.json"
        ]
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "crush": {
      "npmPackage": "@charmland/crush@latest",
      "npmBin": "crush",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "CRUSH_GLOBAL_CONFIG": "crush/config",
          "CRUSH_GLOBAL_DATA": "crush/data"
        },
        "loginFiles": [
          "data/crush.json"
        ]
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "copilot": {
      "npmPackage": "@github/copilot@latest",
      "npmBin": "copilot",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "COPILOT_HOME": "copilot"
        },
        "loginFiles": [
          "config.json"
        ],
        "hostDir": "~/.copilot"
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "kilo": {
      "npmPackage": "@kilocode/cli@latest",
      "npmBin": "kilo",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".config/kilo",
          ".local/share/kilo"
        ],
        "loginFiles": [
          "profile/.local/share/kilo/auth.json",
          "profile/.config/kilo/kilo.jsonc"
        ]
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "amp": {
      "npmPackage": "@ampcode/cli@latest",
      "npmBin": "amp",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".config/amp",
          ".local/share/amp"
        ],
        "loginFiles": [
          "profile/.local/share/amp/secrets.json"
        ]
      }
    },
    "cline": {
      "npmPackage": "cline@latest",
      "npmBin": "cline",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".cline"
        ],
        "loginFiles": [
          "profile/.cline/data/settings/providers.json"
        ]
      }
    },
    "continue": {
      "npmPackage": "@continuedev/cli@latest",
      "npmBin": "cn",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "CONTINUE_GLOBAL_DIR": "continue"
        },
        "loginFiles": [
          "auth.json"
        ],
        "hostDir": "~/.continue"
      },
      "resumeArguments": [
        "--resume"
      ]
    },
    "kimi": {
      "npmPackage": "@moonshot-ai/kimi-code@latest",
      "npmBin": "kimi",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".kimi-code"
        ],
        "loginFiles": [
          "profile/.kimi-code/config.toml"
        ]
      },
      "resumeArguments": [
        "-c"
      ]
    },
    "reasonix": {
      "npmPackage": "reasonix@latest",
      "npmBin": "reasonix",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {
          "REASONIX_HOME": "reasonix"
        },
        "loginFiles": [
          ".env",
          "config.toml"
        ],
        "hostDir": "%APPDATA%\\reasonix"
      }
    },
    "deepseek": {
      "npmPackage": "codewhale@latest",
      "npmBin": "codewhale",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".codewhale"
        ],
        "loginFiles": [
          "profile/.codewhale/config.toml"
        ]
      }
    },
    "aider": {
      "uvPackage": "aider-chat",
      "uvBin": "aider",
      "arguments": [],
      "environment": {},
      "home": {
        "env": {},
        "profileDirs": [
          ".aider"
        ],
        "loginFiles": [
          "profile/.aider/oauth-keys.env"
        ]
      },
      "resumeArguments": [
        "--restore-chat-history"
      ]
    }
  },
  "hooks": {
    "failFast": false
  },
  "resume": {
    "sessions": "ask",
    "restartAfterCrash": false
  },
  "projects": {
    "all": false,
    "exclude": [],
    "roots": [],
    "askToAddRoot": true,
    "declinedRoots": [],
    "allowOutsideMappings": "ask",
    "wsbShare": true
  }
}
