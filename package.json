{
  "name": "windows-development-sandbox",
  "version": "1.11.4",
  "description": "A disposable Windows Sandbox for development, with or without an AI agent (Claude Code, Codex, Gemini, opencode, ...): the folder you run it from is the workspace, toolchains and databases for your project install themselves, and nothing else on your PC is reachable.",
  "type": "module",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sandbox": "dist/bin/sandbox.js",
    "windows-development-sandbox": "dist/bin/sandbox.js",
    "agent-sandbox": "dist/bin/agent-sandbox.js",
    "claude-sbx": "dist/bin/claude-sbx.js",
    "claude-sandbox": "dist/bin/claude-sbx.js",
    "codex-sbx": "dist/bin/codex-sbx.js",
    "codex-sandbox": "dist/bin/codex-sbx.js",
    "gemini-sbx": "dist/bin/gemini-sbx.js",
    "gemini-sandbox": "dist/bin/gemini-sbx.js",
    "claude-host": "dist/bin/claude-host.js",
    "sbx-show": "dist/bin/sbx-show.js",
    "sbx-hide": "dist/bin/sbx-hide.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "sandbox",
    "native",
    "schemas",
    "hooks",
    "config.example.json",
    ".sandbox-config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit && node scripts/bundle.mjs && node scripts/bundle-web.mjs && node scripts/schemas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run build && node dist/bin/agent-sandbox.js self-test",
    "prepare": "npm run build",
    "prepack": "npm run rebuild",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "install:global": "node scripts/install-global.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "doctor": "node dist/bin/agent-sandbox.js doctor",
    "lint": "eslint src scripts web",
    "format": "prettier --write src scripts web",
    "format:check": "prettier --check src scripts web",
    "web:preview": "node dist/selftest/support/web-preview.js",
    "web:shots": "node scripts/web-shots.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "claude-code",
    "windows-sandbox",
    "sandbox",
    "agent",
    "codex",
    "gemini",
    "development",
    "opencode",
    "databases",
    "dynamodb"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.12",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.18.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "bundleDependencies": [
    "@inquirer/prompts",
    "commander",
    "ignore",
    "jsonc-parser",
    "lodash",
    "ws",
    "zod"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/modals": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@mantine/spotlight": "7.17.8",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.3",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "mantine-form-zod-resolver": "^1.3.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshDiDuca/windows-development-sandbox.git"
  },
  "homepage": "https://github.com/JoshDiDuca/windows-development-sandbox#readme",
  "bugs": {
    "url": "https://github.com/JoshDiDuca/windows-development-sandbox/issues"
  }
}
