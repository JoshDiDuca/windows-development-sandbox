<Project Sdk="Microsoft.NET.Sdk">
  <!-- FXServer loads server C# from *.net.dll built for .NET Standard 2.0. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>{{name}}.Server</AssemblyName>
    <RootNamespace>{{namespace}}.Server</RootNamespace>
    <TargetName>$(AssemblyName).net</TargetName>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CitizenFX.Core.Server" Version="1.0.*" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
